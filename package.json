{
  "name": "activity7",
  "version": "1.0.0",
  "private": true,
  "description": "Activity 7: modelo relacional de una escuela de robotica con Sequelize",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:undo": "sequelize-cli db:migrate:undo",
    "db:status": "sequelize-cli db:migrate:status",
    "test": "node --test tests/schema.test.js"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "mysql2": "3.24.5",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "nodemon": "3.1.14",
    "sequelize-cli": "6.6.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
