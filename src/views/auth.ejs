<%- include('partials/header') %>
<section class="authgrid"><div><p class="eyebrow"><%= mode === 'register' ? 'EMPIEZA AQUÍ' : 'BIENVENIDO DE NUEVO' %></p><h1><%= mode === 'register' ? 'Hazlo tuyo.' : 'Vuelve a tu espacio.' %></h1><p class="lead"><%= mode === 'register' ? 'Crea tu cuenta para acceder al dashboard.' : 'Inicia sesión para abrir tu panel personal.' %></p><a class="textlink" href="/landingpage">← Volver a la landingpage</a></div><div class="formcard"><h2><%= title %></h2>
<% if(errors.length){ %><div class="alert" role="alert"><% errors.forEach(error=>{ %><p><%= error %></p><% }) %></div><% } %>
<form method="post" action="/<%= mode %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% if(mode==='register'){ %><label for="name">Nombre</label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="100" required value="<%= values.name || '' %>"><% } %>
<label for="email">Correo electrónico</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required value="<%= values.email || '' %>">
<label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" maxlength="128" <%= mode==='register'?'minlength=12':'' %> required>
<% if(mode==='register'){ %><p class="hint">De 12 a 128 caracteres. Puedes usar una frase larga.</p><label for="password_confirmation">Confirmar contraseña</label><input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" maxlength="128" required><% } %>
<button class="button full"><%= mode==='register'?'Crear cuenta':'Entrar al dashboard' %></button></form><p class="hint"><%= mode==='register'?'¿Ya tienes cuenta?':'¿Primera vez aquí?' %> <a href="/<%= mode==='register'?'login':'register' %>"><%= mode==='register'?'Inicia sesión':'Regístrate' %></a></p></div></section>
<%- include('partials/footer') %>
